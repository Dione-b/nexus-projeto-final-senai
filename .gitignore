# Arquivo de ambiente local (nunca versionar)
.env

# Ambiente virtual
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Django
db.sqlite3
staticfiles/
media/

# Mídia enviada (base de conhecimento) — só o .gitkeep é versionado
documents/*
